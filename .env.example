DATABASE_URL="postgresql://postgres:password@localhost:5432/sid_menoua?schema=public"
# Environnement de démonstration (correction n°10) : une base DISTINCTE de DATABASE_URL,
# sur le même serveur Postgres (pas de service supplémentaire nécessaire). Si absente,
# le mode démo est simplement désactivé (aucun compte "demo.*" ne peut se connecter).
DEMO_DATABASE_URL="postgresql://postgres:password@localhost:5432/sid_menoua_demo?schema=public"
NEXTAUTH_SECRET="une-cle-secrete-tres-longue-pour-le-mvp-12345"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Assistance rédactionnelle (facultative, ÉTEINTE par défaut)
# ---------------------------------------------------------------------------
# Ces trois variables suffisent, quel que soit le fournisseur : Mistral,
# Together, Groq, OpenRouter… ou un modèle auto-hébergé (vLLM, Ollama). Tous
# exposent la même interface « compatible OpenAI ». Changer de fournisseur, ou
# passer à l'auto-hébergement, ne demande AUCUNE modification de code.
#
# Laissées vides, le SID rédige avec son moteur de règles — comme aujourd'hui.
#
# Vérifier l'accès :  node --env-file=.env --import tsx scripts/verifier-acces-ia.ts
IA_URL_BASE=""
